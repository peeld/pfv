<?xml version="1.0" encoding="UTF-8"?>
<!-- The built-in "pfvgui" Python module: generated by shiboken6 from
     src/bindings.h and compiled into the exe (see CMakeLists.txt). Every
     object-type here must also be in peel_add_python_bindings(... CLASSES). -->
<typesystem package="pfvgui">
    <load-typesystem name="typesystem_widgets.xml" generate="no"/>

    <!-- For mainWindow(): global functions get no include of their own. -->
    <extra-includes>
        <include file-name="bindings.h" location="global"/>
    </extra-includes>

    <object-type name="MainWindow"/>

    <function signature="mainWindow()">
        <modify-function>
            <modify-argument index="return">
                <define-ownership owner="c++"/>
            </modify-argument>
        </modify-function>
    </function>
</typesystem>
